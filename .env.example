# Frontend
VITE_API_BASE_URL=http://localhost:5000/api
VITE_INSTAGRAM_URL=https://instagram.com/shifa.blooms

# Backend
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-secret
APP_ENV=development
APP_PORT=5000
APP_HOST=0.0.0.0
MAX_CONTENT_LENGTH=1048576
CORS_ORIGINS=http://localhost:5173,https://shifablooms.com,https://www.shifablooms.com

# Flask-Mail
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@shifablooms.com
DEVELOPER_EMAIL=developer@example.com

# Optional Supabase/PostgreSQL
DATABASE_URL=
